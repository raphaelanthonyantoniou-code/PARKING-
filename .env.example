# Copy to .env (or set in your host's dashboard) before starting the server.
PORT=3000
# Public address of the site, used in canonical links, sitemap and social cards.
SITE_URL=https://parkareto.gr
# Where the SQLite database lives. Put it on a persistent volume in production.
DB_FILE=./data/parkareto.db
# Long random string that unlocks /admin. Leave empty to disable the dashboard.
ADMIN_TOKEN=
# Long random string garages use to push live free-space counts to /api/operator.
OPERATOR_KEY=
# 1 = simulate changing availability (demo). Defaults to on, except when NODE_ENV=production.
SIMULATE=1
# Optional: a Slack/Teams/Zapier webhook that receives each new demo request.
NOTIFY_WEBHOOK_URL=
# Set to 1 when running behind a reverse proxy (reads the client IP from X-Forwarded-For).
TRUST_PROXY=0
# REQUIRED in production: long random string used to encrypt authenticator keys. Never change it after launch.
APP_SECRET=
# Email for sign-in codes, verification and security alerts (https://resend.com). Without it, emails go to the log.
RESEND_API_KEY=
MAIL_FROM=Parkareto <no-reply@parkareto.gr>
# Development only: 1 exposes /api/dev/outbox with the codes that would have been emailed. Ignored in production.
DEV_MAILBOX=0
